# Copy this file to .env and fill in real values. Never commit .env itself.

# A long, random secret used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on
PORT=3000

# Comma-free single origin allowed to call the API from a browser (use * only for local dev)
CORS_ORIGIN=*

# Where the SQLite database file lives (defaults to ./taskvault.db)
DB_PATH=

# Only used the very first time the app starts, to create the initial admin account.
# Change this password immediately after your first login.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
